  <lexeme><grapheme>Mecha-Pof</grapheme><alias>Mekka-Pof</alias></lexeme>
  <lexeme><grapheme>pantser</grapheme><alias>pandser</alias></lexeme>
  <lexeme><grapheme>Pantser</grapheme><alias>Pandser</alias></lexeme>
